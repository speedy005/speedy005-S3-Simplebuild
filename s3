    rm -f "$pdir/no.patch" 2>/dev/null
fi

###############################################################################
# Migration of deprecated directories
###############################################################################

for migdir in backup_svn backup_git
do
    if [[ -d "$sdir/$migdir" ]]; then

        mkdir -p "$brepo"

        shopt -s dotglob nullglob

        files=("$sdir/$migdir"/*)

        if (( ${#files[@]} > 0 )); then
            mv -f "${files[@]}" "$brepo/" 2>/dev/null
        fi

        shopt -u dotglob nullglob

        if [[ -f "$brepo/last.tar.gz" ]]; then

            suffix="${migdir: -3}"

            mv -f \
                "$brepo/last.tar.gz" \
                "$brepo/last${suffix}.tar.gz" \
                2>/dev/null

            if [[ -f "$brepo/last${suffix}.tar.gz" ]]; then
                ln -sfn \
                    "$(basename "$brepo/last${suffix}.tar.gz")" \
                    "$brepo/last${suffix}.tar.gz" \
                    2>/dev/null
            fi
        fi

        rmdir "$sdir/$migdir" 2>/dev/null
    fi
done


###############################################################################
# Command dispatcher
###############################################################################

command="$1"

###############################################################################
# Simplebuild commands
###############################################################################

for e in "${s3opts[@]}"
do

    [[ "$e" == "$command" ]] || continue

    case "$e" in

        #######################################################################
        # Commands accepting one optional argument
        #######################################################################

        fix_me|checkout|update_me|reporestore|upload_cam)

            shift

            if declare -F "$e" >/dev/null 2>&1; then
                "$e" "$@"
                exit $?
            fi

            printf 'ERROR: command not implemented: %s\n' "$e" >&2
            exit 1
            ;;

        #######################################################################
        # Menu
        #######################################################################

        menu)

            if [[ -n "${2:-}" ]]; then

                if declare -F _dialog_checkout >/dev/null 2>&1; then
                    _dialog_checkout "$2"
                    exit $?
                fi

            else

                if declare -F _dialog_checkout >/dev/null 2>&1; then
                    _dialog_checkout
                    exit $?
                fi

            fi

            printf 'ERROR: menu function not available\n' >&2
            exit 1
            ;;

        #######################################################################
        # Load toolchain only
        #######################################################################

        loadonly)

            if [[ -z "${2:-}" ]]; then

                declare -F _nl >/dev/null 2>&1 && _nl
                clear 2>/dev/null

                declare -F s3logo >/dev/null 2>&1 && s3logo

                printf '%s\n' \
                    "${r_l:-}  $txt_error: toolchain $txt_parameter $txt_missing${w_l:-}"

                declare -F _help_toolchain >/dev/null 2>&1 &&
                    _help_toolchain

                sleep 2
                exit 1
            fi

            _tmp="$2"

            for t in "${AVAI_TCLIST[@]}"
            do
                if [[ "$t" == "$2" ]]; then

                    if declare -F _load_toolchain >/dev/null 2>&1; then
                        _load_toolchain "$2"
                    fi

                    break
                fi
            done

            if [[ -n "${tc_dl:-}" && -f "$tc_dl" ]]; then

                printf '%s\n' \
                    "${p_l:-}  toolchain for $_tmp loaded"

                exit 0

            fi

            declare -F _nl >/dev/null 2>&1 && _nl
            clear 2>/dev/null

            declare -F s3logo >/dev/null 2>&1 && s3logo

            printf '%s\n' \
                "${r_l:-}  toolchain missing/error"

            exit 1
            ;;

        #######################################################################
        # Toolchain check
        #######################################################################

        tccheck)

            if [[ -z "${2:-}" ]]; then

                declare -F _nl >/dev/null 2>&1 && _nl
                clear 2>/dev/null

                declare -F s3logo >/dev/null 2>&1 && s3logo

                printf '%s\n' \
                    "${r_l:-}  $txt_error: toolchain $txt_parameter $txt_missing${w_l:-}"

                declare -F _help_toolchain >/dev/null 2>&1 &&
                    _help_toolchain

                sleep 2
                exit 1
            fi

            found_tc=0

            for t in "${AVAI_TCLIST[@]}"
            do
                if [[ "$t" == "$2" ]]; then
                    found_tc=1

                    if declare -F _toolchain_check >/dev/null 2>&1; then
                        _toolchain_check "$2"
                        rc=$?
                    else
                        rc=1
                    fi

                    exit "$rc"
                fi
            done

            if (( found_tc == 0 )); then
                printf '%s\n' \
                    "${r_l:-}  toolchain '$2' not found"
                exit 1
            fi
            ;;

        #######################################################################
        # Toolchain repair
        #######################################################################

        tcrepair)

            if [[ -z "${2:-}" ]]; then

                declare -F _nl >/dev/null 2>&1 && _nl
                clear 2>/dev/null

                declare -F s3logo >/dev/null 2>&1 && s3logo

                printf '%s\n' \
                    "${r_l:-}  $txt_error: toolchain $txt_parameter $txt_missing${w_l:-}"

                declare -F _help_toolchain >/dev/null 2>&1 &&
                    _help_toolchain

                sleep 2
                exit 1
            fi

            if declare -F _toolchain_repair >/dev/null 2>&1; then
                _toolchain_repair "$2"
                exit $?
            fi

            printf 'ERROR: _toolchain_repair() not available\n' >&2
            exit 1
            ;;

        #######################################################################
        # Upload
        #######################################################################

        upload)

            if [[ -z "${2:-}" ]]; then

                declare -F _nl >/dev/null 2>&1 && _nl
                clear 2>/dev/null

                declare -F s3logo >/dev/null 2>&1 && s3logo

                printf '%s\n' \
                    "${r_l:-}  $txt_error: $txt_parameter $txt_missing${w_l:-}"

                menucall="yes"

                if declare -F ssh_profiles >/dev/null 2>&1; then
                    ssh_profiles
                else
                    printf 'ERROR: ssh_profiles() not available\n' >&2
                    exit 1
                fi

            else

                if declare -F upload_cam >/dev/null 2>&1; then
                    upload_cam "$2"
                else
                    printf 'ERROR: upload_cam() not available\n' >&2
                    exit 1
                fi
            fi

            exit $?
            ;;

        #######################################################################
        # System check
        #######################################################################

        syscheck)

            if declare -F syscheck >/dev/null 2>&1; then

                if [[ -n "${2:-}" ]]; then
                    syscheck silent "$2"
                else
                    syscheck silent
                fi

                exit $?
            fi

            printf 'ERROR: syscheck() not available\n' >&2
            exit 1
            ;;

        #######################################################################
        # Toolchain editor
        #######################################################################

        tedit)

            if [[ -z "${2:-}" ]]; then
                exit 1
            fi

            for telement in "${INST_TCLIST[@]}"
            do

                if [[ "$telement" == "$2" ]]; then

                    if declare -F tedit >/dev/null 2>&1; then
                        tedit "$2"
                        exit $?
                    fi

                    printf 'ERROR: tedit() not available\n' >&2
                    exit 1
                fi

            done

            clear 2>/dev/null

            declare -F s3logo >/dev/null 2>&1 && s3logo

            printf '%s\n' \
                "${w_l:-}  $2 toolchain not installed${W:-}"

            exit 1
            ;;

        #######################################################################
        # Help
        #######################################################################

        help)

            if declare -F _help >/dev/null 2>&1; then
                _help
                exit $?
            fi

            cat <<EOF

Simplebuild3 ${SIMPLEVERSION}

Usage:
    ./s3 menu
    ./s3 help
    ./s3 version
    ./s3 sysinfo
    ./s3 syscheck
    ./s3 clean

EOF

            exit 0
            ;;

        #######################################################################
        # All other registered commands/plugins
        #######################################################################

        *)

            shift

            if declare -F "$e" >/dev/null 2>&1; then
                "$e" "$@"
                exit $?
            fi

            printf 'ERROR: command/function not available: %s\n' "$e" >&2
            exit 1
            ;;

    esac

done

###############################################################################
# Toolchain build command
###############################################################################

for t in "${AVAI_TCLIST[@]}"
do

    [[ "$t" == "$command" ]] || continue

    TOOLCHAIN="$t"

    ###########################################################################
    # "here" option
    ###########################################################################

    if [[ "${2:-}" == here* ]]; then
        EXTRA_COPY_DIR=1
    else
        EXTRA_COPY_DIR=0
    fi

    ###########################################################################
    # Profile argument
    #
    # ./s3 TOOLCHAIN -p=profile
    # ./s3 TOOLCHAIN -P=profile
    ###########################################################################

    if [[ "${2:-}" == -p=* || "${2:-}" == -P=* ]]; then

        profile_name="${2#*=}"

        if [[ -f "$profdir/$profile_name" ]]; then

            pf="$(cat "$profdir/$profile_name")"
            pf_name="$profile_name"

        else

            printf 'ERROR: profile not found: %s\n' \
                "$profile_name" >&2

            exit 1
        fi
    fi

    ###########################################################################
    # Third argument profile
    #
    # FIXED: original script incorrectly used $2 here.
    ###########################################################################

    if [[ "${3:-}" == -p=* || "${3:-}" == -P=* ]]; then

        profile_name="${3#*=}"

        if [[ -f "$profdir/$profile_name" ]]; then

            pf="$(cat "$profdir/$profile_name")"
            pf_name="$profile_name"

        else

            printf 'ERROR: profile not found: %s\n' \
                "$profile_name" >&2

            exit 1
        fi
    fi

    ###########################################################################
    # Build command line
    ###########################################################################

    if [[ "$pf" == "empty" ]]; then
        c_m_d="$*"
    else
        c_m_d="all_off $pf $*"
    fi

    ###########################################################################
    # Parse build options
    ###########################################################################

    all_cc=()

    # shellcheck disable=SC2086
    for cmd in $c_m_d
    do

        #######################################################################
        # Custom configuration directory
        #######################################################################

        if [[ "${cmd:0:3}" == "-c=" || "${cmd:0:3}" == "-C=" ]]; then

            CUSTOM_CONFDIR="${cmd#*=}"

        fi

        #######################################################################
        # OSCam binary name
        #######################################################################

        if [[ "${cmd:0:11}" == "-oscamname=" ]]; then

            USE_vars[USE_OSCAMNAME]="USE_OSCAMNAME=${cmd#*=}"

        fi

        #######################################################################
        # Configuration cases
        #######################################################################

        for cc in "${config_cases[@]}"
        do

            if [[ "$cmd" == "$cc$on" ]]; then
                all_cc+=("$cc$on")
                break
            fi

            if [[ "$cmd" == "$cc$off" ]]; then
                all_cc+=("$cc$off")
                break
            fi

        done

        #######################################################################
        # Short module names
        #######################################################################

        for sm in "${SHORT_MODULENAMES[@]}"
        do

            if [[ "$cmd" == "$sm" ]]; then

                module_name="$(
                    get_module_name "$sm" 2>/dev/null
                )"

                [[ -n "$module_name" ]] &&
                    all_cc+=("${module_name}${on}")

                break
            fi

            if [[ "$cmd" == "$sm$off" ]]; then

                module_name="$(
                    get_module_name "$sm" 2>/dev/null
                )"

                [[ -n "$module_name" ]] &&
                    all_cc+=("${module_name}${off}")

                break
            fi

        done

        #######################################################################
        # USE variables
        #######################################################################

        for uvar in "${!USE_vars[@]}"
        do

            if [[ "$cmd" == "$uvar" ]]; then

                USE_vars["$uvar"]="$uvar=1"
                break

            fi

            if [[ "$cmd" == "$uvar$off" ]]; then

                USE_vars_disable["$uvar"]="$uvar=1"
                break

            fi

        done

        #######################################################################
        # Special flags
        #######################################################################

        case "$cmd" in

            OPENBOX)
                OPENBOX=1
                ;;

            UFS916003)
                UFS916003=1
                ;;

            USE_VERBOSE)
                s3cfg_vars[USE_VERBOSE]=1
                ;;

        esac

    done

    ###########################################################################
    # Start build
    ###########################################################################

    if declare -F _pre_build >/dev/null 2>&1; then

        _pre_build "$TOOLCHAIN"
        exit $?

    fi

    printf 'ERROR: _pre_build() not available\n' >&2
    exit 1

done

###############################################################################
# Unknown command
###############################################################################

if declare -F _help >/dev/null 2>&1; then
    _help
    exit 1
fi

cat <<EOF

Simplebuild3 ${SIMPLEVERSION}

Unknown command: $command

Try:

    ./s3 help
    ./s3 menu
    ./s3 version
    ./s3 sysinfo
    ./s3 syscheck

EOF

exit 1

###############################################################################
# IMPORTANT:
# Robust URL checker.
#
# This overrides an old/broken check_url() implementation from an older
# function file and fixes:
#
#   curl: (3) URL rejected: Malformed input to a URL function
#
###############################################################################

check_url()
{
    local url="${1:-}"
    local timeout="${s3cfg_vars[S3_URL_CHECK]:-10}"
    local http_code="000"
    local curl_exit=0
    local curl_output=""

    # Remove CR/LF.
    url="${url//$'\r'/}"
    url="${url//$'\n'/}"

    # Trim whitespace.
    url="${url#"${url%%[![:space:]]*}"}"
    url="${url%"${url##*[![:space:]]}"}"

    # Empty URL.
    if [[ -z "$url" ]]; then
        printf '%sURL is empty!%s\n' \
            "${r_l:-}" \
            "${re_:-}"
        return 1
    fi

    # SSH Git URL - curl is not appropriate here.
    if [[ "$url" == git@* ]]; then
        return 0
    fi

    # HTTP/HTTPS only.
    if [[ ! "$url" =~ ^https?:// ]]; then
        printf '%sInvalid URL: %s%s\n' \
            "${r_l:-}" \
            "$url" \
            "${re_:-}"
        return 1
    fi

    # Make timeout safe.
    if ! [[ "$timeout" =~ ^[0-9]+$ ]]; then
        timeout=10
    fi

    # 0 disables URL checking.
    if (( timeout <= 0 )); then
        return 0
    fi

    curl_output="$(
        curl \
            --silent \
            --show-error \
            --location \
            --output /dev/null \
            --write-out '%{http_code}' \
            --connect-timeout "$timeout" \
            --max-time "$((timeout + 5))" \
            "$url" \
            2>&1
    )"

    curl_exit=$?

    if (( curl_exit != 0 )); then

        if [[ "$curl_output" =~ ^[0-9]{3}$ ]]; then
            http_code="$curl_output"
            curl_output=""
        else
            http_code="000"
        fi

        printf '%s%s is not reachable! (HTTP status: %s, curl exit: %s)%s\n' \
            "${r_l:-}" \
            "$url" \
            "$http_code" \
            "$curl_exit" \
            "${re_:-}"

        if [[ -n "$curl_output" ]]; then
            printf '%s%s%s\n' \
                "${r_l:-}" \
                "$curl_output" \
                "${re_:-}"
        fi

        return 1
    fi

    http_code="$curl_output"

    # 2xx = success
    # 3xx = reachable after redirect
    # 401 = server reachable, authentication required
    case "$http_code" in
        2*|3*|401)
            return 0
            ;;
        *)
            printf '%s%s is not reachable! (HTTP status: %s, curl exit: 0)%s\n' \
                "${r_l:-}" \
                "$url" \
                "$http_code" \
                "${re_:-}"
            return 1
            ;;
    esac
}


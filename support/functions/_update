#!/bin/bash

update_me(){
	clear;s3logo
	printf "  s3_git CHECK:\n  -------------\n"
	local_revision=0
	online_revision=0
	check_url "$s3url" || return

	if [ ! -d $workdir/.git ]; then
		s3local="$dldir/s3_github"

		local_revision=$(gitrevision $s3local)
		online_revision=$(gitrevision $s3url)

		if [ ! "$local_revision" == "$online_revision" ]
		then
			printf "  update s3_git\n  Local revision: $local_revision\n Online revision: $online_revision\n"
			rm -rf "$s3local"; git clone "$s3url" "$s3local" &>/dev/null; cd "$s3local"
			printf "  updating all files ...\n\n"
			yes | cp -rf ./s3 "$workdir/s3"
			yes | cp -rf ./support/* "$workdir/support"
		else
			printf "  is up to date\n   Online revision: $online_revision\n\n"
		fi
	
    else
        logfile="$ldir/$(date +%F.%H%M%S)_update_me.log"

        (
            cd "$workdir" || exit 1

            echo "S3 Speedy005 Update-Check"
            echo "========================"

            git fetch speedy005 master || {
                echo "FEHLER: Speedy005 konnte nicht abgerufen werden."
                exit 1
            }

            local_commit=$(git rev-parse --short HEAD)
            online_commit=$(git rev-parse --short speedy005/master)

            echo "Lokaler Commit: $local_commit"
            echo "Speedy005-Commit: $online_commit"
            echo

            if git diff --quiet HEAD speedy005/master; then
                echo "Die versionierten Dateien stimmen mit Speedy005 überein."
            else
                echo "UPDATE VERFÜGBAR oder Dateien unterscheiden sich."
                echo
                echo "Änderungen zwischen lokalem Stand und Speedy005:"
                git diff --stat HEAD speedy005/master
                echo
                echo "Lokale Änderungen im Arbeitsverzeichnis:"
                git status --short
                echo
                echo "Es wurden keine Dateien überschrieben."
            fi
        ) 2>&1 | _log "$logfile"
    fi

	sleep 2
}

fix_me(){
	clear
	s3logo
	s3local="$dldir/s3_github"

	[ -d "$s3local" ] && rm -rf $s3local
	update_me
}


update_me() {
    clear
    s3logo

    printf "  S3 GIT UPDATE – NEUE UND GEÄNDERTE DATEIEN\n"
    printf "  -----------------------------------------\n"

    local remote candidate remote_url remote_ref
    local logfile tmpdir tree changed_file rel src dest
    local backup_root backup copied updated skipped failed
    local result tracked protected

    check_url "$s3url" || return 1

    if [ ! -d "$workdir/.git" ]; then
        echo "FEHLER: Kein Git-Repository im Arbeitsverzeichnis."
        return 1
    fi

    mkdir -p "$ldir" "$dldir" || return 1
    logfile="$ldir/$(date +%F.%H%M%S)_update_me.log"

    (
        cd "$workdir" || exit 1

        echo "S3 Speedy005 – Update"
        echo "====================="

        # Speedy005-Remote ermitteln
        remote=""

        for candidate in speedy005 origin; do
            remote_url=$(git remote get-url "$candidate" 2>/dev/null) || continue

            if [[ "$remote_url" == *"speedy005-S3-Simplebuild"* ]]; then
                remote="$candidate"
                break
            fi
        done

        if [ -z "$remote" ]; then
            echo "FEHLER: Kein Speedy005-Remote gefunden."
            git remote -v
            exit 1
        fi

        echo "Remote: $remote"

        # Aktuellen Online-Stand abrufen
        if ! git fetch "$remote" refs/heads/master; then
            echo "FEHLER: Git-Download fehlgeschlagen."
            exit 1
        fi

        remote_ref="FETCH_HEAD"

        echo "Lokaler Commit: $(git rev-parse --short HEAD)"
        echo "Online-Commit:  $(git rev-parse --short "$remote_ref")"
        echo

        # Temporären Downloadbereich erstellen
        tmpdir=$(mktemp -d "$dldir/s3_update.XXXXXX") || exit 1
        trap 'rm -rf -- "$tmpdir"' EXIT

        tree="$tmpdir/tree"
        changed_file="$tmpdir/changed-files"

        mkdir -p "$tree" || exit 1

        # Online-Dateien in einen temporären Ordner exportieren
        if ! git archive "$remote_ref" | tar -xf - -C "$tree"; then
            echo "FEHLER: Online-Dateien konnten nicht entpackt werden."
            exit 1
        fi

        # Geänderte und neu hinzugefügte Pfade seit lokalem HEAD
        if ! git diff --name-only --no-renames -z \
            HEAD "$remote_ref" > "$changed_file"; then
            echo "FEHLER: Git-Dateiliste konnte nicht ermittelt werden."
            exit 1
        fi

        # Dauerhafte Sicherung außerhalb des temporären Ordners
        backup_root="$ldir/update_backup_$(date +%F_%H%M%S)"
        mkdir -p "$backup_root" || exit 1

        copied=0
        updated=0
        skipped=0
        failed=0

        while IFS= read -r -d '' rel; do
            src="$tree/$rel"
            dest="$workdir/$rel"

            # Online gelöschte Dateien lokal nicht löschen
            if [ ! -e "$src" ] && [ ! -L "$src" ]; then
                echo "ÜBERSPRUNGEN (online gelöscht): $rel"
                skipped=$((skipped + 1))
                continue
            fi

            # Zielordner anlegen, falls die Datei neu ist
            if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
                if ! mkdir -p -- "$(dirname "$dest")"; then
                    echo "FEHLER: Zielordner nicht erstellbar: $rel"
                    failed=$((failed + 1))
                    continue
                fi

                if cp -a -- "$src" "$dest"; then
                    echo "NEU KOPIERT: $rel"
                    copied=$((copied + 1))
                else
                    echo "FEHLER beim Kopieren: $rel"
                    failed=$((failed + 1))
                fi
                continue
            fi

            # Nur vorhandene, von Git verwaltete Dateien aktualisieren
            if ! git ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
                echo "ÜBERSPRUNGEN (lokale Datei): $rel"
                skipped=$((skipped + 1))
                continue
            fi

            # Lokale Änderungen niemals automatisch überschreiben
            if ! git diff --quiet HEAD -- "$rel"; then
                echo "ÜBERSPRUNGEN (lokal geändert): $rel"
                skipped=$((skipped + 1))
                continue
            fi

            # Konfigurationen und Patches nicht automatisch ersetzen
            protected=0
            case "$rel" in
                support/configs/*|support/patches/*)
                    protected=1
                    ;;
            esac

            if [ "$protected" -eq 1 ]; then
                echo "ÜBERSPRUNGEN (Konfiguration/Patch): $rel"
                skipped=$((skipped + 1))
                continue
            fi

            # Unveränderte Dateien nicht unnötig ersetzen
            if cmp -s -- "$src" "$dest"; then
                continue
            fi

            # Datei vor dem Ersetzen sichern
            if ! mkdir -p -- "$backup_root/$(dirname "$rel")"; then
                echo "FEHLER: Sicherungsordner nicht erstellbar: $rel"
                failed=$((failed + 1))
                continue
            fi

            if ! cp -a -- "$dest" "$backup_root/$rel"; then
                echo "FEHLER: Sicherung fehlgeschlagen: $rel"
                failed=$((failed + 1))
                continue
            fi

            # Online-Version installieren
            if cp -a -- "$src" "$dest"; then
                echo "AKTUALISIERT: $rel"
                updated=$((updated + 1))
            else
                echo "FEHLER beim Aktualisieren: $rel"
                failed=$((failed + 1))
            fi

        done < "$changed_file"

        echo
        echo "Update abgeschlossen."
        echo "Neue Dateien:             $copied"
        echo "Aktualisierte Dateien:    $updated"
        echo "Übersprungene Dateien:    $skipped"
        echo "Fehler:                   $failed"
        echo "Sicherungen:              $backup_root"
        echo
        echo "Hinweis: Lokale Änderungen, Konfigurationen und Patches"
        echo "wurden vor automatischem Überschreiben geschützt."

        [ "$failed" -eq 0 ] || exit 1

    ) 2>&1 | _log "$logfile"

    result=${PIPESTATUS[0]}
    sleep 2
    return "$result"
}

fix_me() {
    update_me
}

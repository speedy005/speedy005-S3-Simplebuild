
update_me() {
    clear
    s3logo

    printf "  S3 GIT UPDATE – NEUE GIT-DATEIEN\n"
    printf "  --------------------------------\n"

    local remote candidate remote_url remote_ref
    local logfile tmpdir tree added_file src rel dest
    local copied skipped failed result

    check_url "$s3url" || return 1

    if [ ! -d "$workdir/.git" ]; then
        echo "FEHLER: Kein Git-Repository im Arbeitsverzeichnis."
        return 1
    fi

    mkdir -p "$ldir" "$dldir" || return 1
    logfile="$ldir/$(date +%F.%H%M%S)_update_me.log"

    (
        cd "$workdir" || exit 1

        echo "S3 Speedy005 – Neue Git-Dateien kopieren"
        echo "========================================"

        # Speedy005-Remote finden
        remote=""

        for candidate in speedy005 origin; do
            remote_url=$(git remote get-url "$candidate" 2>/dev/null) || continue

            if [[ "$remote_url" == *"speedy005-S3-Simplebuild"* ]]; then
                remote="$candidate"
                break
            fi
        done

        if [ -z "$remote" ]; then
            echo "FEHLER: Kein Speedy005-Remote gefunden."
            git remote -v
            exit 1
        fi

        echo "Remote: $remote"

        # Aktuellen Online-Stand laden
        if ! git fetch "$remote" refs/heads/master; then
            echo "FEHLER: Git-Download fehlgeschlagen."
            exit 1
        fi

        remote_ref="FETCH_HEAD"
        echo "Lokaler Commit: $(git rev-parse --short HEAD)"
        echo "Online-Commit:  $(git rev-parse --short "$remote_ref")"
        echo

        # Temporären Arbeitsbereich erstellen
        tmpdir=$(mktemp -d "$dldir/s3_update.XXXXXX") || exit 1
        trap 'rm -rf -- "$tmpdir"' EXIT

        tree="$tmpdir/tree"
        added_file="$tmpdir/added-files"

        mkdir -p "$tree" || exit 1

        # Nur Pfade ermitteln, die im Online-Git neu hinzugekommen sind
        if ! git diff --diff-filter=A --name-only -z \
            HEAD "$remote_ref" > "$added_file"; then
            echo "FEHLER: Git-Dateiliste konnte nicht ermittelt werden."
            exit 1
        fi

        # Online-Version temporär exportieren
        if ! git archive "$remote_ref" | tar -xf - -C "$tree"; then
            echo "FEHLER: Git-Dateien konnten nicht entpackt werden."
            exit 1
        fi

        copied=0
        skipped=0
        failed=0

        while IFS= read -r -d '' rel; do
            src="$tree/$rel"
            dest="$workdir/$rel"

            # Unerwartete bzw. nicht vorhandene Quellen überspringen
            if [ ! -e "$src" ] && [ ! -L "$src" ]; then
                echo "FEHLER: Quelle fehlt: $rel"
                failed=$((failed + 1))
                continue
            fi

            # Bestehende Dateien niemals überschreiben
            if [ -e "$dest" ] || [ -L "$dest" ]; then
                echo "ÜBERSPRUNGEN (existiert): $rel"
                skipped=$((skipped + 1))
                continue
            fi

            if ! mkdir -p -- "$(dirname "$dest")"; then
                echo "FEHLER: Zielordner nicht erstellbar: $rel"
                failed=$((failed + 1))
                continue
            fi

            if cp -a -- "$src" "$dest"; then
                echo "NEU KOPIERT: $rel"
                copied=$((copied + 1))
            else
                echo "FEHLER beim Kopieren: $rel"
                failed=$((failed + 1))
            fi
        done < "$added_file"

        echo
        echo "Update abgeschlossen."
        echo "Neue Git-Dateien kopiert: $copied"
        echo "Bereits vorhanden:        $skipped"
        echo "Fehler:                   $failed"
        echo "Bestehende Dateien wurden nicht überschrieben."

        [ "$failed" -eq 0 ] || exit 1
    ) 2>&1 | _log "$logfile"

    result=${PIPESTATUS[0]}
    sleep 2
    return "$result"
}

fix_me() {
    update_me
}

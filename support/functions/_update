
#!/bin/bash

update_me(){
	clear
	s3logo

	printf "  s3_git CHECK:\n  -------------\n"
	local_revision=0
	online_revision=0

	check_url "$s3url" || return

	if [ ! -d "$workdir/.git" ]; then
		s3local="$dldir/s3_github"

		local_revision=$(gitrevision "$s3local")
		online_revision=$(gitrevision "$s3url")

		if [ "$local_revision" != "$online_revision" ]; then
			printf "  update s3_git\n"
			printf "  Local revision: %s\n" "$local_revision"
			printf "  Online revision: %s\n" "$online_revision"

			echo
			echo "Kein Git-Repository im Arbeitsverzeichnis gefunden."
			echo "Aus Sicherheitsgründen werden keine Dateien überschrieben."
			echo "Bitte aktualisiere dieses Verzeichnis separat."
		else
			printf "  is up to date\n"
			printf "  Online revision: %s\n\n" "$online_revision"
		fi

	else
		logfile="$ldir/$(date +%F.%H%M%S)_update_me.log"

		(
			cd "$workdir" || exit 1

			echo "S3 Speedy005 Update-Check"
			echo "========================"

			# Passenden Remote anhand der URL ermitteln
			remote=""

			for candidate in speedy005 origin; do
				remote_url=$(git remote get-url "$candidate" 2>/dev/null) || continue

				if [[ "$remote_url" == *"speedy005-S3-Simplebuild"* ]]; then
					remote="$candidate"
					break
				fi
			done

			if [ -z "$remote" ]; then
				echo "FEHLER: Kein Speedy005-Remote gefunden."
				echo "Vorhandene Remotes:"
				git remote -v
				exit 1
			fi

			echo "Verwendeter Remote: $remote"
			echo

			# Remote-Stand abrufen, ohne Arbeitsdateien zu überschreiben
			if ! git fetch "$remote" master; then
				echo "FEHLER: Speedy005 konnte nicht abgerufen werden."
				exit 1
			fi

			remote_ref="$remote/master"

			local_commit=$(git rev-parse --short HEAD) || exit 1
			online_commit=$(git rev-parse --short "$remote_ref") || exit 1

			echo
			echo "Lokaler Commit: $local_commit"
			echo "Speedy005-Commit: $online_commit"
			echo

			if git diff --quiet HEAD "$remote_ref"; then
				echo "Die versionierten Dateien stimmen mit Speedy005 überein."
			else
				echo "UPDATE VERFÜGBAR oder Dateien unterscheiden sich."
				echo
				echo "Änderungen zwischen lokalem Stand und Speedy005:"
				git diff --stat HEAD "$remote_ref"
				echo
				echo "Lokale Änderungen im Arbeitsverzeichnis:"
				git status --short
				echo
				echo "Es wurden keine Dateien überschrieben."
			fi
		) 2>&1 | _log "$logfile"
	fi

	sleep 2
}

fix_me(){
	clear
	s3logo
	s3local="$dldir/s3_github"

	if [ -d "$s3local" ]; then
		rm -rf -- "$s3local"
	fi

	update_me
}

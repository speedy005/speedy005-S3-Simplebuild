
update_me() {
    clear    
    s3logo

    printf "  S3 GIT UPDATE – PROGRAMMDATEIEN AKTUALISIEREN\n"
    printf "  --------------------------------------------\n"

    local remote candidate remote_url remote_ref
    local logfile tmpdir tree manifest rel src dest
    local backup_root copied updated unchanged protected failed
    local result

    check_url "$s3url" || return 1

    if [ ! -d "$workdir/.git" ]; then
        echo "FEHLER: Kein Git-Repository im Arbeitsverzeichnis."
        return 1
    fi

    mkdir -p "$ldir" "$dldir" || return 1
    logfile="$ldir/$(date +%F.%H%M%S)_update_me.log"

    (
        set -o pipefail
        cd "$workdir" || exit 1

        echo "S3 Speedy005 – Programmdateien aktualisieren"
        echo "============================================"

        # Speedy005-Remote finden
        remote=""

        for candidate in speedy005 origin; do
            remote_url=$(git remote get-url "$candidate" 2>/dev/null) || continue

            if [[ "$remote_url" == *"speedy005-S3-Simplebuild"* ]]; then
                remote="$candidate"
                break
            fi
        done

        if [ -z "$remote" ]; then
            echo "FEHLER: Kein Speedy005-Remote gefunden."
            git remote -v
            exit 1
        fi

        echo "Remote: $remote"

        # Aktuellen Online-Stand abrufen
        if ! git fetch "$remote" refs/heads/master; then
            echo "FEHLER: Git-Download fehlgeschlagen."
            exit 1
        fi

        remote_ref="FETCH_HEAD"

        echo "Lokaler Commit: $(git rev-parse --short HEAD)"
        echo "Online-Commit:  $(git rev-parse --short "$remote_ref")"
        echo

        # Online-Dateien in temporären Ordner exportieren
        tmpdir=$(mktemp -d "$dldir/s3_update.XXXXXX") || exit 1
        trap 'rm -rf -- "$tmpdir"' EXIT

        tree="$tmpdir/tree"
        manifest="$tmpdir/manifest"

        mkdir -p "$tree" || exit 1

        if ! git archive "$remote_ref" | tar -xf - -C "$tree"; then
            echo "FEHLER: Online-Dateien konnten nicht exportiert werden."
            exit 1
        fi

        # Dateiliste mit NUL-Trennung, damit Sonderzeichen funktionieren
        if ! (
            cd "$tree" && find . -mindepth 1 -print0
        ) > "$manifest"; then
            echo "FEHLER: Dateiliste konnte nicht erstellt werden."
            exit 1
        fi

        # Sicherungen dauerhaft im Log-Verzeichnis ablegen
        backup_root="$ldir/update_backup_$(date +%F_%H%M%S)_$$"

        copied=0
        updated=0
        unchanged=0
        protected=0
        failed=0

        while IFS= read -r -d '' rel; do
            rel="${rel#./}"
            src="$tree/$rel"
            dest="$workdir/$rel"

            # Nur reguläre Dateien und Symlinks aus dem Git-Export behandeln.
            # Verzeichnisse entstehen bei Bedarf automatisch.
            if [ -d "$src" ] && [ ! -L "$src" ]; then
                continue
            fi

            if [ ! -f "$src" ] && [ ! -L "$src" ]; then
                echo "ÜBERSPRUNGEN (kein regulärer Dateityp): $rel"
                protected=$((protected + 1))
                continue
            fi

            # Kritische lokale Konfigurationen und Patches schützen
            case "$rel" in
                support/configs|support/configs/*|\
                support/patches|support/patches/*|\
                oscamsource.url)
                    if [ -e "$dest" ] || [ -L "$dest" ]; then
                        echo "GESCHÜTZT: $rel"
                        protected=$((protected + 1))
                        continue
                    fi
                    ;;
            esac

            # Neue Datei kopieren, wenn sie lokal fehlt
            if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
                if ! mkdir -p -- "$(dirname "$dest")"; then
                    echo "FEHLER: Zielordner nicht erstellbar: $rel"
                    failed=$((failed + 1))
                    continue
                fi

                if cp -a -- "$src" "$dest"; then
                    echo "NEU KOPIERT: $rel"
                    copied=$((copied + 1))
                else
                    echo "FEHLER beim Kopieren: $rel"
                    failed=$((failed + 1))
                fi
                continue
            fi

            # Bereits vorhandene Verzeichnisse nicht durch Dateien ersetzen
            if [ -d "$dest" ] && [ ! -L "$dest" ]; then
                echo "GESCHÜTZT (Ziel ist Verzeichnis): $rel"
                protected=$((protected + 1))
                continue
            fi

            # Identische Dateien nicht unnötig ersetzen
            if [ -f "$src" ] && [ -f "$dest" ] &&
               [ ! -L "$src" ] && [ ! -L "$dest" ] &&
               cmp -s -- "$src" "$dest"; then
                unchanged=$((unchanged + 1))
                continue
            fi

            # Vorhandene Datei oder Symlink vor Änderung sichern
            if ! mkdir -p -- "$backup_root/$(dirname "$rel")"; then
                echo "FEHLER: Sicherungsordner nicht erstellbar: $rel"
                failed=$((failed + 1))
                continue
            fi

            if ! cp -a -- "$dest" "$backup_root/$rel"; then
                echo "FEHLER: Sicherung fehlgeschlagen: $rel"
                failed=$((failed + 1))
                continue
            fi

            # Online-Version installieren
            if cp -a --remove-destination -- "$src" "$dest"; then
                echo "AKTUALISIERT: $rel"
                updated=$((updated + 1))
            else
                echo "FEHLER beim Aktualisieren: $rel"
                failed=$((failed + 1))
            fi

        done < "$manifest"

        echo
        echo "Update abgeschlossen."
        echo "Neue Dateien:             $copied"
        echo "Aktualisierte Dateien:    $updated"
        echo "Unverändert:              $unchanged"
        echo "Geschützte Dateien:       $protected"
        echo "Fehler:                   $failed"

        if [ "$updated" -gt 0 ]; then
            echo "Sicherungen: $backup_root"
        else
            echo "Keine vorhandenen Dateien ersetzt."
        fi

        echo
        echo "Hinweis: Lokale Dateien außerhalb des Online-Git"
        echo "wurden nicht gelöscht. Konfigurationen und Patches"
        echo "wurden geschützt."

        [ "$failed" -eq 0 ] || exit 1

    ) 2>&1 | _log "$logfile"

    result=${PIPESTATUS[0]}
    sleep 2
    return "$result"
}

fix_me() {
    update_me
}

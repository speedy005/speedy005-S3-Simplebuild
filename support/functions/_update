update_me() {
clear
s3logo

printf "  S3 GIT UPDATE – PROGRAMMDATEIEN AKTUALISIEREN\n"
printf "  --------------------------------------------\n"

local remote candidate remote_url remote_ref
local logfile tmpdir tree manifest rel src dest
local backup_root copied updated unchanged protected failed
local result staged tracked mode

check_url "$s3url" || return 1

if ! git -C "$workdir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "FEHLER: Kein Git-Arbeitsverzeichnis."
    return 1
fi

mkdir -p "$ldir" "$dldir" || return 1
logfile="$ldir/$(date +%F.%H%M%S)_update_me.log"

(
    set -o pipefail
    cd "$workdir" || exit 1

    echo "S3 Speedy005 – Programmdateien aktualisieren"
    echo "============================================"

    remote=""
    for candidate in speedy005 origin; do
        remote_url=$(git remote get-url "$candidate" 2>/dev/null) || continue
        if [[ "$remote_url" == *"speedy005-S3-Simplebuild"* ]]; then
            remote="$candidate"
            break
        fi
    done

    if [ -z "$remote" ]; then
        echo "FEHLER: Kein Speedy005-Remote gefunden."
        git remote -v
        exit 1
    fi

    echo "Remote: $remote"

    if ! git fetch "$remote" refs/heads/master; then
        echo "FEHLER: Git-Download fehlgeschlagen."
        exit 1
    fi

    remote_ref="FETCH_HEAD"
    echo "Lokaler Commit: $(git rev-parse --short HEAD)"
    echo "Online-Commit:  $(git rev-parse --short "$remote_ref")"
    echo

    tmpdir=$(mktemp -d "$dldir/s3_update.XXXXXX") || exit 1
    trap 'rm -rf -- "$tmpdir"' EXIT

    tree="$tmpdir/tree"
    manifest="$tmpdir/manifest"
    mkdir -p "$tree" || exit 1

    if ! git archive "$remote_ref" | tar -xf - -C "$tree"; then
        echo "FEHLER: Online-Dateien konnten nicht exportiert werden."
        exit 1
    fi

    if ! (cd "$tree" && find . -mindepth 1 -print0) > "$manifest"; then
        echo "FEHLER: Dateiliste konnte nicht erstellt werden."
        exit 1
    fi

    backup_root="$ldir/update_backup_$(date +%F_%H%M%S)_$$"
    copied=0
    updated=0
    unchanged=0
    protected=0
    failed=0

    while IFS= read -r -d '' rel; do
        rel="${rel#./}"

        # Pfade außerhalb des Projektverzeichnisses ablehnen.
        case "$rel" in
            ""|/*|..|../*|*/../*|*/..)
                echo "FEHLER: Unsicherer Online-Pfad: $rel"
                failed=$((failed + 1))
                continue
                ;;
        esac

        src="$tree/$rel"
        dest="$workdir/$rel"

        # Verzeichnisse nicht direkt als Dateien installieren.
        if [ -d "$src" ] && [ ! -L "$src" ]; then
            continue
        fi

        if [ ! -f "$src" ] && [ ! -L "$src" ]; then
            echo "ÜBERSPRUNGEN (Dateityp nicht unterstützt): $rel"
            protected=$((protected + 1))
            continue
        fi

        # Lokale Konfigurationen, Patches und Quell-URL schützen.
        # Fehlt eine solche Datei lokal, darf sie neu angelegt werden.
        case "$rel" in
            support/configs|support/configs/*|\
            support/patches|support/patches/*|\
            oscamsource.url)
                if [ -e "$dest" ] || [ -L "$dest" ]; then
                    echo "GESCHÜTZT: $rel"
                    protected=$((protected + 1))
                    continue
                fi
                ;;
        esac

        # Vorhandene Symlinks und Verzeichnisse niemals ersetzen.
        if [ -L "$dest" ]; then
            echo "GESCHÜTZT (Symlink): $rel"
            protected=$((protected + 1))
            continue
        fi

        if [ -d "$dest" ]; then
            echo "GESCHÜTZT (Ziel ist Verzeichnis): $rel"
            protected=$((protected + 1))
            continue
        fi

        tracked=0
        if git ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
            tracked=1
        fi

        # Lokal geänderte versionierte Dateien dreifach zusammenführen:
        # lokale Datei + Basis-Commit + Online-Datei.
        if [ "$tracked" -eq 1 ] && { ! git diff --quiet HEAD -- "$rel" || ! git diff --cached --quiet -- "$rel"; }; then
            if [ ! -f "$dest" ] || [ -L "$dest" ]; then
                echo "LOKAL GELÖSCHT ODER SONDERDATEI – GESCHÜTZT: $rel"
                protected=$((protected + 1))
                continue
            fi

            basefile="$tmpdir/merge_base"
            merged="$tmpdir/merge_result"

            if ! git show "HEAD:$rel" > "$basefile"; then
                echo "BASIS FEHLT – GESCHÜTZT: $rel"
                protected=$((protected + 1))
                continue
            fi

            # Wenn online keine Änderung gegenüber der Basis vorliegt,
            # bleibt die lokale Version unangetastet.
            if cmp -s -- "$basefile" "$src"; then
                echo "NUR LOKAL GEÄNDERT – BEIBEHALTEN: $rel"
                protected=$((protected + 1))
                continue
            fi

            if git merge-file -p "$dest" "$basefile" "$src" > "$merged"; then
                if ! mkdir -p -- "$backup_root/$(dirname "$rel")"; then
                    echo "FEHLER: Sicherungsordner nicht erstellbar: $rel"
                    failed=$((failed + 1))
                    continue
                fi
                if ! cp -a -- "$dest" "$backup_root/$rel"; then
                    echo "FEHLER: Sicherung fehlgeschlagen: $rel"
                    failed=$((failed + 1))
                    continue
                fi

                staged="$(dirname "$dest")/.s3_update_stage_$$"
                if [ -e "$staged" ] || [ -L "$staged" ]; then
                    echo "FEHLER: Temporäres Ziel existiert bereits: $staged"
                    failed=$((failed + 1))
                    continue
                fi
                if ! cp -- "$merged" "$staged" || ! chmod --reference="$dest" "$staged"; then
                    rm -f -- "$staged"
                    echo "FEHLER: Zusammenführung konnte nicht vorbereitet werden: $rel"
                    failed=$((failed + 1))
                    continue
                fi
                if mv -fT -- "$staged" "$dest"; then
                    echo "ZUSAMMENGEFÜHRT: $rel"
                    updated=$((updated + 1))
                else
                    rm -f -- "$staged"
                    echo "FEHLER: Zusammenführung konnte nicht installiert werden: $rel"
                    failed=$((failed + 1))
                fi
                continue
            else
                merge_status=$?
                if [ "$merge_status" -eq 1 ]; then
                    conflict_root="$ldir/update_conflicts_$(date +%F_%H%M%S)_$$"
                    conflict_file="$conflict_root/$rel.merge"
                    if mkdir -p -- "$(dirname "$conflict_file")" &&
                       cp -- "$merged" "$conflict_file"; then
                        echo "MERGE-KONFLIKT – LOKALE DATEI BEHALTEN: $rel"
                        echo "Zusammenführungsvorschlag: $conflict_file"
                    else
                        echo "MERGE-KONFLIKT; Vorschlag konnte nicht gespeichert werden: $rel"
                        failed=$((failed + 1))
                    fi
                    protected=$((protected + 1))
                    continue
                fi
                echo "FEHLER bei Zusammenführung: $rel"
                failed=$((failed + 1))
                continue
            fi
        fi

        # Vorhandene lokale Dateien ohne Git-Eintrag nicht überschreiben.
        if [ -e "$dest" ] && [ "$tracked" -eq 0 ]; then
            echo "UNVERSIONIERT – GESCHÜTZT: $rel"
            protected=$((protected + 1))
            continue
        fi

        # Identische reguläre Dateien nicht unnötig ersetzen.
        if [ -f "$src" ] && [ -f "$dest" ] &&
           [ ! -L "$src" ] && cmp -s -- "$src" "$dest"; then
            unchanged=$((unchanged + 1))
            continue
        fi

        # Online-Datei in das Zielverzeichnis vorbereiten.
        if ! mkdir -p -- "$(dirname "$dest")"; then
            echo "FEHLER: Zielordner nicht erstellbar: $rel"
            failed=$((failed + 1))
            continue
        fi

        staged="$(dirname "$dest")/.s3_update_stage_$$"
        if [ -e "$staged" ] || [ -L "$staged" ]; then
            echo "FEHLER: Temporäres Ziel existiert bereits: $staged"
            failed=$((failed + 1))
            continue
        fi

        if ! cp -a -- "$src" "$staged"; then
            echo "FEHLER: Online-Datei konnte nicht vorbereitet werden: $rel"
            rm -f -- "$staged"
            failed=$((failed + 1))
            continue
        fi

        # Vorhandene versionierte Datei vor Austausch sichern.
        if [ -e "$dest" ] || [ -L "$dest" ]; then
            if ! mkdir -p -- "$backup_root/$(dirname "$rel")"; then
                echo "FEHLER: Sicherungsordner nicht erstellbar: $rel"
                rm -f -- "$staged"
                failed=$((failed + 1))
                continue
            fi

            if ! cp -a -- "$dest" "$backup_root/$rel"; then
                echo "FEHLER: Sicherung fehlgeschlagen: $rel"
                rm -f -- "$staged"
                failed=$((failed + 1))
                continue
            fi
        fi

        # Atomarer Austausch innerhalb desselben Dateisystems.
        # cp -a übernimmt die Git-Modi, darunter das Ausführungsrecht.
        if mv -fT -- "$staged" "$dest"; then
            if [ "$tracked" -eq 0 ]; then
                echo "NEU KOPIERT: $rel"
                copied=$((copied + 1))
            else
                echo "AKTUALISIERT: $rel"
                updated=$((updated + 1))
            fi
        else
            echo "FEHLER beim Installieren: $rel"
            rm -f -- "$staged"
            failed=$((failed + 1))
        fi

    done < "$manifest"

    echo
    echo "Update abgeschlossen."
    echo "Neue Dateien:          $copied"
    echo "Aktualisierte Dateien: $updated"
    echo "Unverändert:           $unchanged"
    echo "Geschützt:             $protected"
    echo "Fehler:                $failed"
    echo "Sicherungen:           $backup_root"
    echo
    echo "Lokale Dateien, die nicht im Online-Git stehen,"
    echo "wurden nicht gelöscht."

    [ "$failed" -eq 0 ] || exit 1

) 2>&1 | _log "$logfile"

result=${PIPESTATUS[0]}
sleep 2
return "$result"

}

fix_me() {
update_me
}

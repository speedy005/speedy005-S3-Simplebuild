
update_me() {
    clear
    s3logo

    printf "  S3 GIT UPDATE – ALLE NEUEN DATEIEN\n"
    printf "  ----------------------------------\n"

    local remote candidate remote_url remote_ref
    local logfile tmpdir src rel dest
    local copied skipped failed result

    check_url "$s3url" || return 1

    if [ ! -d "$workdir/.git" ]; then
        echo "FEHLER: Kein Git-Repository im Arbeitsverzeichnis."
        return 1
    fi

    mkdir -p "$ldir" "$dldir" || return 1
    logfile="$ldir/$(date +%F.%H%M%S)_update_me.log"

    (
        cd "$workdir" || exit 1

        echo "S3 Speedy005 – Neue Dateien kopieren"
        echo "===================================="

        # Speedy005-Remote finden
        remote=""

        for candidate in speedy005 origin; do
            remote_url=$(git remote get-url "$candidate" 2>/dev/null) || continue

            if [[ "$remote_url" == *"speedy005-S3-Simplebuild"* ]]; then
                remote="$candidate"
                break
            fi
        done

        if [ -z "$remote" ]; then
            echo "FEHLER: Kein Speedy005-Remote gefunden."
            git remote -v
            exit 1
        fi

        echo "Remote: $remote"

        # Aktuellen Git-Stand laden
        if ! git fetch "$remote" refs/heads/master; then
            echo "FEHLER: Git-Download fehlgeschlagen."
            exit 1
        fi

        remote_ref="FETCH_HEAD"
        echo "Online-Commit: $(git rev-parse --short "$remote_ref")"

        # Git-Dateien temporär exportieren
        tmpdir=$(mktemp -d "$dldir/s3_update.XXXXXX") || exit 1
        trap 'rm -rf -- "$tmpdir"' EXIT

        if ! git archive "$remote_ref" | tar -xf - -C "$tmpdir"; then
            echo "FEHLER: Git-Dateien konnten nicht entpackt werden."
            exit 1
        fi

        copied=0
        skipped=0
        failed=0

        # Alle Dateien rekursiv prüfen, auch versteckte Dateien
        while IFS= read -r -d '' src; do
            rel="${src#"$tmpdir"/}"
            dest="$workdir/$rel"

            # Vorhandene Dateien, Symlinks und Ordner nicht ersetzen
            if [ -e "$dest" ] || [ -L "$dest" ]; then
                if [ -d "$src" ] && [ ! -L "$src" ] &&
                   [ -d "$dest" ] && [ ! -L "$dest" ]; then
                    continue
                fi

                skipped=$((skipped + 1))
                continue
            fi

            if ! mkdir -p -- "$(dirname "$dest")"; then
                echo "FEHLER: Ordner nicht erstellbar: $rel"
                failed=$((failed + 1))
                continue
            fi

            if cp -a -- "$src" "$dest"; then
                echo "KOPIERT: $rel"
                copied=$((copied + 1))
            else
                echo "FEHLER: $rel"
                failed=$((failed + 1))
            fi
        done < <(find "$tmpdir" -mindepth 1 -print0)

        echo
        echo "Update abgeschlossen."
        echo "Neu kopiert:                 $copied"
        echo "Bereits vorhanden:           $skipped"
        echo "Fehler:                      $failed"
        echo "Bestehende Dateien wurden nicht überschrieben."

        [ "$failed" -eq 0 ] || exit 1
    ) 2>&1 | _log "$logfile"

    result=${PIPESTATUS[0]}
    sleep 2
    return "$result"
}

fix_me() {
    update_me
}

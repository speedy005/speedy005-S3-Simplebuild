
#!/bin/bash

update_me() {
    clear
    s3logo

    printf "  s3_git UPDATE\n  -------------\n"

    local logfile remote candidate remote_url remote_ref
    local local_commit online_commit answer

    check_url "$s3url" || return 1

    if [ ! -d "$workdir/.git" ]; then
        echo
        echo "Kein Git-Repository im Arbeitsverzeichnis gefunden."
        echo "Es wird nichts automatisch überschrieben."
        sleep 2
        return 1
    fi

    mkdir -p "$ldir" || return 1
    logfile="$ldir/$(date +%F.%H%M%S)_update_me.log"

    (
        cd "$workdir" || exit 1

        echo "S3 Speedy005 Update"
        echo "==================="

        # Remote anhand der Repository-URL finden
        remote=""

        for candidate in speedy005 origin; do
            remote_url=$(git remote get-url "$candidate" 2>/dev/null) || continue

            if [[ "$remote_url" == *"speedy005-S3-Simplebuild"* ]]; then
                remote="$candidate"
                break
            fi
        done

        if [ -z "$remote" ]; then
            echo "FEHLER: Kein passender Speedy005-Remote gefunden."
            git remote -v
            exit 1
        fi

        echo "Remote: $remote"
        echo

        # Aktualisiert FETCH_HEAD, nicht die Arbeitsdateien.
        if ! git fetch "$remote" refs/heads/master; then
            echo "FEHLER: Update konnte nicht abgerufen werden."
            exit 1
        fi

        remote_ref="FETCH_HEAD"

        local_commit=$(git rev-parse --short HEAD) || exit 1
        online_commit=$(git rev-parse --short "$remote_ref") || exit 1

        echo "Lokaler Commit:  $local_commit"
        echo "Online-Commit:   $online_commit"
        echo

        if git diff --quiet HEAD "$remote_ref" &&
           [ "$(git rev-parse HEAD)" = "$(git rev-parse "$remote_ref")" ]; then
            echo "S3 ist bereits auf dem aktuellen Commit."
            exit 0
        fi

        echo "Änderungen zwischen lokalem Stand und Online-Version:"
        git diff --stat HEAD "$remote_ref"
        echo

        # Vor einer Installation müssen Index, Arbeitsdateien und
        # unversionierte Dateien sauber sein.
        if [ -n "$(git status --porcelain --untracked-files=all)" ]; then
            echo "UPDATE NICHT INSTALLIERT:"
            echo "Das Arbeitsverzeichnis enthält lokale Änderungen"
            echo "oder zusätzliche Dateien."
            echo
            echo "Diese zuerst sichern bzw. separat prüfen."
            echo "Es wurden keine Projektdateien überschrieben."
            git status --short
            exit 2
        fi

        # Nur installieren, wenn der lokale Commit Vorfahr des
        # Online-Commits ist. Keine History überschreiben.
        if ! git merge-base --is-ancestor HEAD "$remote_ref"; then
            echo "UPDATE NICHT INSTALLIERT:"
            echo "Kein sicherer Fast-Forward möglich."
            echo "Lokaler und Online-Verlauf müssen separat geprüft werden."
            exit 3
        fi

        echo
        read -r -p "Update auf $online_commit installieren? [j/N] " answer

        case "$answer" in
            j|J|ja|JA|Ja)
                if git merge --ff-only "$remote_ref"; then
                    echo
                    echo "Update erfolgreich installiert."
                    echo "Neuer Commit: $(git rev-parse --short HEAD)"
                else
                    echo "FEHLER: Installation fehlgeschlagen."
                    exit 1
                fi
                ;;
            *)
                echo "Update nicht installiert."
                ;;
        esac
    ) 2>&1 | _log "$logfile"

    local result=${PIPESTATUS[0]}
    sleep 2
    return "$result"
}

fix_me() {
    clear
    s3logo

    echo "Die Update-Prüfung löscht keine Verzeichnisse."
    echo "Starte die sichere Update-Prüfung ..."
    echo

    update_me
}

#!/bin/bash

# ============================================================
#  NEON ANSI COLORS 🌈
#  Usage:
#    initializeANSI
#    echo -e "${C}Neon Cyan${RESET}"
#    echo -e "${P}Hot Pink${RESET}"
# ============================================================

initializeANSI() {

    # Reset
    RESET='\033[0m'
    RESET_FG='\033[39m'
    RESET_BG='\033[49m'

    # Text styles
    BOLD='\033[1m'
    DIM='\033[2m'
    ITALIC='\033[3m'
    UNDERLINE='\033[4m'
    BLINK='\033[5m'

    # --------------------------------------------------------
    # Standard colors
    # --------------------------------------------------------
    BLACK='\033[0;30m'
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    PURPLE='\033[0;35m'
    CYAN='\033[0;36m'
    WHITE='\033[0;37m'

    # --------------------------------------------------------
    # Bright / neon colors ✨
    # --------------------------------------------------------
    GRAY='\033[0;90m'
    BRIGHT_RED='\033[1;91m'
    BRIGHT_GREEN='\033[1;92m'
    BRIGHT_YELLOW='\033[1;93m'
    BRIGHT_BLUE='\033[1;94m'
    BRIGHT_PURPLE='\033[1;95m'
    BRIGHT_CYAN='\033[1;96m'
    BRIGHT_WHITE='\033[1;97m'

    # --------------------------------------------------------
    # Cool aliases – compatible with your old variable names
    # --------------------------------------------------------
    bk_n='\033[0;30m'
    r_n='\033[0;31m'
    g_n='\033[0;32m'
    y_n='\033[0;33m'
    b_n='\033[0;34m'
    p_n='\033[0;35m'
    c_n='\033[0;36m'
    w_n='\033[0;37m'

    bk_l='\033[1;90m'
    r_l='\033[1;91m'
    g_l='\033[1;92m'
    y_l='\033[1;93m'
    b_l='\033[1;94m'
    p_l='\033[1;95m'
    c_l='\033[1;96m'
    w_l='\033[1;97m'

    # --------------------------------------------------------
    # Background colors
    # --------------------------------------------------------
    bk_nb='\033[40m'
    r_nb='\033[41m'
    g_nb='\033[42m'
    y_nb='\033[43m'
    b_nb='\033[44m'
    p_nb='\033[45m'
    c_nb='\033[46m'
    w_nb='\033[47m'

    dg_lb='\033[100m'
    r_lb='\033[101m'
    g_lb='\033[102m'
    y_lb='\033[103m'
    b_lb='\033[104m'
    p_lb='\033[105m'
    c_lb='\033[106m'
    lg_lb='\033[107m'

    # --------------------------------------------------------
    # Modern aliases for your existing scripts
    # --------------------------------------------------------
    W='\033[0m'
    Y='\033[1;93m'
    YH='\033[38;5;220m'
    R='\033[1;91m'
    G='\033[1;92m'
    GH='\033[38;5;46m'
    P='\033[38;5;213m'
    C='\033[1;96m'
    WH='\033[1;97m'

    # Extra neon colors (256-color terminals)
    NEON_PINK='\033[38;5;201m'
    NEON_PURPLE='\033[38;5;135m'
    NEON_BLUE='\033[38;5;51m'
    NEON_ORANGE='\033[38;5;208m'
    NEON_LIME='\033[38;5;118m'
    NEON_GOLD='\033[38;5;220m'
    DARK_GRAY='\033[38;5;240m'

    # Semantic colors
    INFO="$NEON_BLUE"
    SUCCESS="$NEON_LIME"
    WARNING="$NEON_ORANGE"
    ERROR="$BRIGHT_RED"
    TITLE="$NEON_PINK"
    MUTED="$DARK_GRAY"

    # Backward-compatible reset names
    re_="$RESET"
    re_f="$RESET_FG"
    re_b="$RESET_BG"
}